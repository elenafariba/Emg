{
    "name": "emergency",
    "forwardPorts": [3000],
    "portsAttributes": {
        "3000": {
            "label": "App",
            "onAutoForward": "openBrowser",
            "visibility": "public"
        }
    },
    "postCreateCommand": "npm install",
    "postStartCommand": "nohup node server.js > /tmp/server.log 2>&1 &"
}
